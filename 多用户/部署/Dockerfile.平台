FROM public.ecr.aws/docker/library/python:3.14.6-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN groupadd --gid 10002 xjgw \
    && useradd --uid 10002 --gid 10002 --create-home --home-dir /home/xjgw xjgw
WORKDIR /app
COPY 多用户/requirements.txt /tmp/platform-requirements.txt
RUN pip install --no-cache-dir -r /tmp/platform-requirements.txt \
    && rm -f /tmp/platform-requirements.txt
COPY 多用户/控制面/ /app/多用户/控制面/
COPY 多用户/搜索网关/ /app/多用户/搜索网关/
COPY 多用户/网关/ /app/多用户/网关/
COPY 多用户/界面/ /app/多用户/界面/
COPY 多用户/部署/__init__.py 多用户/部署/发布仓库.py 多用户/部署/平台命令.py 多用户/部署/候选验收.py 多用户/部署/监督服务命令.py 多用户/部署/控制中继.py 多用户/部署/精排中继.py 多用户/部署/本机入口.py 多用户/部署/数据契约.json /app/多用户/部署/
RUN find /app -type d -exec chmod 0755 {} + \
    && find /app -type f -exec chmod 0444 {} +
ARG XJ_COMPANY_VERSION=unversioned
ARG XJ_FORMAL_SOURCE_SHA256=unknown
ENV XJ_COMPANY_VERSION=${XJ_COMPANY_VERSION} \
    XJ_FORMAL_SOURCE_SHA256=${XJ_FORMAL_SOURCE_SHA256}
LABEL org.xj.company.version=${XJ_COMPANY_VERSION} \
      org.xj.company.formal-source-sha256=${XJ_FORMAL_SOURCE_SHA256}
USER 10002:10002
